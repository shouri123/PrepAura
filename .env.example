# PrepAura Environment Configuration Template

# -----------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens (generate a strong random string in production)
SECRET_KEY=prepaura-simulation-ultra-secure-key-2026-precision-jwt

# Database connection URL (default: async SQLite)
# For production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/prepaura
DATABASE_URL=sqlite+aiosqlite:///./prepaura.db

# Environment mode: development | staging | production
ENVIRONMENT=development

# JWT Token expiration in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite)
# -----------------------------------------------------------------------------
# Base API URL (defaults to Vite proxy /api in development)
VITE_API_URL=/api

# Offline fallback simulation mode (true | false)
VITE_USE_MOCK=false
